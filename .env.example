APP_NAME=erlebt
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Lokale Datenbank aus docker-compose.yml
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=erlebt
DB_USERNAME=erlebt
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
CACHE_STORE=database
QUEUE_CONNECTION=database

# Claude API (Pflicht)
ANTHROPIC_API_KEY=
MODEL_QUESTIONS=claude-haiku-5-5
MODEL_REVIEW=claude-sonnet-5-5

# Google Places (optional: ohne Schlüssel gibt es allgemeine Fragen)
GOOGLE_PLACES_API_KEY=

# Harte Kostenbremse pro Tag
MAX_RUNS_PER_DAY=20

# Dein Login, wird per "php artisan db:seed --force" angelegt
ADMIN_EMAIL=
ADMIN_PASSWORD=
